#!/usr/bin/env pypy3
import sys
import math
import heapq
from array import array

# ---------------- fast I/O --------------------
def load_obj():
    tok = sys.stdin.buffer.read().split()
    nv, nf = int(tok[0]), int(tok[1])
    V = [(float(tok[p+1]), float(tok[p+2]), float(tok[p+3]))
         for p in range(2, 2 + 4*nv, 4)]
    F = [(int(tok[p+1])-1, int(tok[p+2])-1, int(tok[p+3])-1)
         for p in range(2 + 4*nv, len(tok), 4)]
    return V, F, nv, nf

def save_obj(V, F, v_del, f_del):
    v_map = [-1] * len(V)
    cnt = 0
    for i in range(len(V)):
        if not v_del[i]:
            v_map[i] = cnt
            cnt += 1
    newV = [V[i] for i in range(len(V)) if not v_del[i]]
    newF = [(v_map[a], v_map[b], v_map[c]) for i, (a,b,c) in enumerate(F) if not f_del[i]]
    out = [f"{cnt} {len(newF)}"]
    for x,y,z in newV:
        out.append(f"v {x:.10g} {y:.10g} {z:.10g}")
    for a,b,c in newF:
        out.append(f"f {a+1} {b+1} {c+1}")
    sys.stdout.write("\n".join(out) + "\n")

# --------------- geometry helpers ---------------
def cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])
def dot(a,b): return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]
def sub(a,b): return (a[0]-b[0], a[1]-b[1], a[2]-b[2])
def length(v): return math.sqrt(v[0]*v[0]+v[1]*v[1]+v[2]*v[2])
def normalize(v):
    l = length(v)
    return (v[0]/l, v[1]/l, v[2]/l) if l>1e-12 else (0.0,0.0,0.0)
def face_normal(v0,v1,v2):
    return normalize(cross(sub(v1,v0), sub(v2,v0)))
def area(v0,v1,v2):
    return length(cross(sub(v1,v0), sub(v2,v0))) * 0.5

# ---------- QEM quadric (10 floats) -----------
def quadric_from_plane(nx, ny, nz, d):
    # (nx,ny,nz,-d) outer product
    return (nx*nx, nx*ny, nx*nz, -nx*d,
            ny*ny, ny*nz, -ny*d,
            nz*nz, -nz*d, d*d)
def eval_quadric(q, x, y, z):
    return (q[0]*x*x + 2*q[1]*x*y + 2*q[2]*x*z + 2*q[3]*x +
            q[4]*y*y + 2*q[5]*y*z + 2*q[6]*y +
            q[7]*z*z + 2*q[8]*z + q[9])

# -------------- main simplification -------------
def simplify(V, F, nv, nf):
    # --- bounding box diagonal (for Hausdorff) ---
    xs, ys, zs = [v[0] for v in V], [v[1] for v in V], [v[2] for v in V]
    diag = math.sqrt((max(xs)-min(xs))**2 + (max(ys)-min(ys))**2 + (max(zs)-min(zs))**2)
    hausdorff_tol = 0.05 * diag

    # --- face normals ---
    fn = [face_normal(V[a], V[b], V[c]) for (a,b,c) in F]

    # --- vertex-face adjacency (compact array per vertex) ---
    deg = [0] * nv
    for (a,b,c) in F:
        deg[a] += 1; deg[b] += 1; deg[c] += 1
    vf_data = [array('I', [0]) * deg[i] for i in range(nv)]  # placeholder
    vf_pos = [0] * nv
    for fi, (a,b,c) in enumerate(F):
        vf_data[a][vf_pos[a]] = fi; vf_pos[a] += 1
        vf_data[b][vf_pos[b]] = fi; vf_pos[b] += 1
        vf_data[c][vf_pos[c]] = fi; vf_pos[c] += 1

    # --- edge data ---
    edge_map = {}
    edge_v1 = array('I')
    edge_v2 = array('I')
    edge_f0 = array('i')
    edge_f1 = array('i')
    edge_del = array('b')
    edge_sharp = array('b')
    def add_edge(v1, v2, face):
        key = (v1, v2) if v1 < v2 else (v2, v1)
        if key in edge_map:
            eid = edge_map[key]
            if edge_f0[eid] == -1:
                edge_f0[eid] = face
            else:
                edge_f1[eid] = face
        else:
            eid = len(edge_v1)
            edge_map[key] = eid
            edge_v1.append(key[0]); edge_v2.append(key[1])
            edge_f0.append(face); edge_f1.append(-1)
            edge_del.append(0); edge_sharp.append(0)
    for fi, (a,b,c) in enumerate(F):
        add_edge(a, b, fi); add_edge(b, c, fi); add_edge(c, a, fi)
    ne = len(edge_v1)

    # --- sharp edge detection (dihedral angle > 30°) ---
    SHARP_DEG = math.radians(30.0)
    for eid in range(ne):
        f0 = edge_f0[eid]; f1 = edge_f1[eid]
        if f0 == -1 or f1 == -1: continue
        d = dot(fn[f0], fn[f1])
        d = max(-1.0, min(1.0, d))
        if math.acos(d) > SHARP_DEG:
            edge_sharp[eid] = 1

    # --- vertex quadrics ---
    v_q = [[0.0]*10 for _ in range(nv)]
    for fi, (a,b,c) in enumerate(F):
        n = fn[fi]
        p = V[a]
        d = dot(n, p)
        qp = quadric_from_plane(n[0], n[1], n[2], d)
        for v in (a,b,c):
            for i in range(10):
                v_q[v][i] += qp[i]

    # --- delete markers ---
    v_del = [False] * nv
    f_del = [False] * nf

    # --- link condition ---
    def link_ok(keep, remove):
        # neighbours of keep excluding remove
        n_keep = set()
        for fi in vf_data[keep]:
            if f_del[fi]: continue
            for w in F[fi]:
                if w != keep and w != remove:
                    n_keep.add(w)
        n_remove = set()
        for fi in vf_data[remove]:
            if f_del[fi]: continue
            for w in F[fi]:
                if w != remove and w != keep:
                    n_remove.add(w)
        return len(n_keep & n_remove) == 2

    # --- helper: distance from a point to a triangle ---
    def point_to_triangle_dist(p, a, b, c):
        # using barycentric technique
        ab = sub(b, a); ac = sub(c, a); ap = sub(p, a)
        d1 = dot(ab, ap); d2 = dot(ac, ap)
        if d1 <= 0 and d2 <= 0: return length(ap)
        bp = sub(p, b)
        d3 = dot(ab, bp); d4 = dot(ac, bp)
        if d3 >= 0 and d4 <= d3: return length(bp)
        cp = sub(p, c)
        d5 = dot(ab, cp); d6 = dot(ac, cp)
        if d6 >= 0 and d5 <= d6: return length(cp)
        vc = d1*d4 - d3*d2
        if vc <= 0 and d1 >= 0 and d3 <= 0:
            return length(sub(p, a))
        vb = d5*d2 - d1*d6
        if vb <= 0 and d2 >= 0 and d6 <= 0:
            return length(sub(p, a))
        va = d3*d6 - d5*d4
        if va <= 0 and (d4 - d3) >= 0 and (d5 - d6) >= 0:
            return length(sub(p, b))
        # inside triangle, distance to plane
        n = cross(ab, ac)
        l = length(n)
        if l < 1e-12: return length(ap)
        return abs(dot(ap, n)) / l

    # --- normal deviation check ---
    def normal_deviation_ok(keep, remove, f0, f1):
        for fi in vf_data[remove]:
            if fi == f0 or fi == f1 or f_del[fi]:
                continue
            a,b,c = F[fi]
            if a == remove: a = keep
            elif b == remove: b = keep
            else: c = keep
            new_n = face_normal(V[a], V[b], V[c])
            d = dot(fn[fi], new_n)
            d = max(-1.0, min(1.0, d))
            if math.acos(d) > math.radians(10.0):  # 10° limit
                return False
        return True

    # --- Hausdorff check for removed vertex ---
    def hausdorff_ok(remove, keep, f0, f1):
        p = V[remove]
        for fi in vf_data[remove]:
            if fi == f0 or fi == f1 or f_del[fi]:
                continue
            a,b,c = F[fi]
            if a == remove: a = keep
            elif b == remove: b = keep
            else: c = keep
            dist = point_to_triangle_dist(p, V[a], V[b], V[c])
            if dist > hausdorff_tol:
                return False
        return True

    # --- collapse operation ---
    def collapse(edge_id, keep, remove):
        nonlocal edge_map
        f0, f1 = edge_f0[edge_id], edge_f1[edge_id]
        # mark faces as deleted
        f_del[f0] = f_del[f1] = True
        edge_del[edge_id] = 1
        # remove these faces from vf
        for v in F[f0]:
            arr = vf_data[v]
            # linear removal (okay, small arrays)
            vf_data[v] = array('I', (x for x in arr if x != f0 and x != f1))
        for v in F[f1]:
            arr = vf_data[v]
            vf_data[v] = array('I', (x for x in arr if x != f0 and x != f1))

        # modify other faces incident to remove
        for fi in list(vf_data[remove]):  # copy because we'll modify vf_data
            if f_del[fi]: continue
            a,b,c = F[fi]
            if a == remove: a = keep
            elif b == remove: b = keep
            else: c = keep
            F[fi] = (a,b,c)
            # recompute normal (original fn[fi] unchanged, but we don't need it for later)
            # update vf for the three vertices
            for v in (a,b,c):
                arr = vf_data[v]
                # add fi if not present (should not be present anymore)
                if fi not in arr:
                    vf_data[v] = array('I', list(arr) + [fi])
            # remove from remove's vf (will be handled by final deletion)
        vf_data[remove] = array('I', [])   # empty
        v_del[remove] = True
        # update quadrics: keep quadric += remove quadric
        for i in range(10):
            v_q[keep][i] += v_q[remove][i]
        # update edges: remove edges that had f0/f1, add new edges around keep
        # we'll do a local rebuild of affected edges via scanning faces of keep later
        # For now, we just push new candidates from keep's faces.

    # --- priority queue ---
    pq = []
    for eid in range(ne):
        if edge_sharp[eid] or edge_del[eid]:
            continue
        v1, v2 = edge_v1[eid], edge_v2[eid]
        f0, f1 = edge_f0[eid], edge_f1[eid]
        if f0 == -1 or f1 == -1: continue
        # try both directions
        for keep, remove in ((v1,v2),(v2,v1)):
            if not link_ok(keep, remove): continue
            if not normal_deviation_ok(keep, remove, f0, f1): continue
            if not hausdorff_ok(remove, keep, f0, f1): continue
            cost = eval_quadric(v_q[keep], V[keep][0], V[keep][1], V[keep][2]) + \
                   eval_quadric(v_q[remove], V[keep][0], V[keep][1], V[keep][2])
            heapq.heappush(pq, (cost, eid, keep, remove))

    # --- main loop ---
    while pq:
        cost, eid, keep, remove = heapq.heappop(pq)
        if edge_del[eid] or v_del[keep] or v_del[remove]:
            continue
        f0, f1 = edge_f0[eid], edge_f1[eid]
        if f_del[f0] or f_del[f1]:
            continue
        # re-validate
        if not link_ok(keep, remove): continue
        if not normal_deviation_ok(keep, remove, f0, f1): continue
        if not hausdorff_ok(remove, keep, f0, f1): continue
        # perform collapse
        collapse(eid, keep, remove)
        # push new candidate edges from keep's faces
        for fi in vf_data[keep]:
            if f_del[fi]: continue
            a,b,c = F[fi]
            for (v1,v2) in [(a,b),(b,c),(c,a)]:
                key = (v1,v2) if v1 < v2 else (v2,v1)
                if key not in edge_map:
                    # new edge; add it
                    ne = len(edge_v1)
                    edge_map[key] = ne
                    edge_v1.append(key[0]); edge_v2.append(key[1])
                    edge_f0.append(fi); edge_f1.append(-1)
                    edge_del.append(0); edge_sharp.append(0)
                    # sharp check
                    n1 = fn[fi]
                    # find adjacent face for sharpness? Can't yet, push later
                eid2 = edge_map[key]
                if edge_sharp[eid2] or edge_del[eid2]:
                    continue
                # update faces for edge
                if edge_f0[eid2] == -1:
                    edge_f0[eid2] = fi
                elif edge_f1[eid2] == -1:
                    edge_f1[eid2] = fi
                # if both faces now set, push candidate
                f0_e, f1_e = edge_f0[eid2], edge_f1[eid2]
                if f0_e != -1 and f1_e != -1:
                    for K,R in ((v1,v2),(v2,v1)):
                        if v_del[K] or v_del[R]: continue
                        if not link_ok(K,R): continue
                        if not normal_deviation_ok(K,R, f0_e, f1_e): continue
                        if not hausdorff_ok(R, K, f0_e, f1_e): continue
                        cost2 = eval_quadric(v_q[K], V[K][0], V[K][1], V[K][2])
                        heapq.heappush(pq, (cost2, eid2, K, R))

    return v_del, f_del

# ---------------- entry point ------------------
if __name__ == "__main__":
    V, F, nv, nf = load_obj()
    v_del, f_del = simplify(V, F, nv, nf)
    save_obj(V, F, v_del, f_del)
